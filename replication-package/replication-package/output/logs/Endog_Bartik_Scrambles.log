. use ${CurrentData}, clear

. keep fipsnumeric quarter_index county_index logmeanwks* logunemp* logxstate* 
> bartik_state seprate year quarter fipsstate pair_id_numeric

. 
. * ---- generate the 200 scrambles (identical seed/method to the kit Scrambles
>  exporter) ----
. preserve

. keep pair_id_numeric fipsnumeric

. sort pair_id_numeric fipsnumeric

. duplicates drop pair_id_numeric fipsnumeric, force

Duplicates in terms of pair_id_numeric fipsnumeric

(232,056 observations deleted)

. set seed 85237940

. forvalues x=1/200{
  2.         sort pair_id_numeric fipsnumeric
  3.         gen rand=runiform()
  4.         sort rand
  5.         gen new_pair_id`x'=floor((_n+1)/2)
  6.         drop rand
  7.         sort new_pair_id`x' fipsnumeric
  8.         by new_pair_id`x': gen new_county_index`x'=_n
  9. }

. sort pair_id_numeric fipsnumeric

. tempfile scrambles

. save `scrambles', replace
(file /var/folders/yv/gy9l8r0n7q96t36797h3fbd00000gn/T//St79982.000002 not
    found)
file /var/folders/yv/gy9l8r0n7q96t36797h3fbd00000gn/T//St79982.000002 saved
    as .dta format

. restore

. merge m:1 pair_id_numeric fipsnumeric using `scrambles', keep(match) nogen

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                           234,400  
    -----------------------------------------

. 
. * ---- loop: per scramble, build the IV regressors and run the endogeneity te
> st ----
. matrix scramble_iv = J(200, 4, .)   // [benefits_noctrl, benefits_iv, did_sta
> teu_iv, N]

. preserve

. forvalues x=1/200{
  2. 
.         qui replace pair_id_numeric = new_pair_id`x'
  3.         qui replace county_index    = new_county_index`x'
  4. 
.         * cross-pair differences (across the two counties of a scrambled pair
> )
.         sort pair_id_numeric quarter_index county_index
  5.         foreach var of varlist logmeanwks logunemp_rate_laus logxstate_une
> mp bartik_state {
  6.                 capture drop diff_`var'
  7.                 qui by pair_id_numeric quarter_index: gen diff_`var' = `va
> r'[1] - `var'[2]
  8.         }
  9. 
.         * 1-period quasi-difference of unemployment (LHS)
.         sort pair_id_numeric county_index quarter_index
 10.         capture drop f1_logunemp_rate_laus
 11.         capture drop qdk1_logunemp_rate_laus
 12.         qui by pair_id_numeric county_index: gen f1_logunemp_rate_laus = d
> iff_logunemp_rate_laus[_n+1]
 13.         qui by pair_id_numeric county_index: gen qdk1_logunemp_rate_laus =
>  ///
>                 diff_logunemp_rate_laus - ((0.99*(1-seprate))^1)*f1_logunemp_
> rate_laus
 14. 
.         keep if county_index==1
 15.         qui duplicates drop pair_id_numeric quarter_index, force
 16. 
.         * time-differences: the (instrumented) change in cross-pair state une
> mployment
.         sort pair_id_numeric quarter_index
 17.         capture drop did_stateu
 18.         capture drop did_bartik
 19.         qui by pair_id_numeric: gen did_stateu = diff_logxstate_unemp[_n] 
> - diff_logxstate_unemp[_n-1]
 20.         qui by pair_id_numeric: gen did_bartik = diff_bartik_state[_n]   -
>  diff_bartik_state[_n-1]
 21. 
.         xtset pair_id_numeric quarter_index
 22. 
.         * benefits without the control (the upward-biased scrambled estimate 
> ~0.107)
.         qui reghdfe qdk1_logunemp_rate_laus diff_logmeanwks if inrange(year,2
> 005,2012), ///
>                 absorb(pair_id_numeric)
 23.         matrix scramble_iv[`x',1] = _b[diff_logmeanwks]
 24. 
.         * add Bartik-instrumented change in state unemployment (chi) -> benef
> its, did_stateu
.         capture xtivreg qdk1_logunemp_rate_laus diff_logmeanwks (did_stateu =
>  did_bartik) ///
>                 if inrange(year,2005,2012), fe
 25.         if _rc==0 {
 26.                 matrix scramble_iv[`x',2] = _b[diff_logmeanwks]
 27.                 matrix scramble_iv[`x',3] = _b[did_stateu]
 28.                 matrix scramble_iv[`x',4] = e(N)
 29.         }
 30. 
.         display "Scramble `x' of 200 done"
 31.         restore, preserve
 32. }
