. restore

. 
. * ---- save the 200-scramble distribution ----
. clear

. svmat scramble_iv
number of observations will be reset to 200
Press any key to continue, or Break to abort
Number of observations (_N) was 0, now 200.

. rename scramble_iv1 benefits_noctrl

. rename scramble_iv2 benefits_iv

. rename scramble_iv3 did_stateu_iv

. rename scramble_iv4 Nobs

. qui outsheet using "${latexdir}Scrambles_IV_bartik.csv", comma replace

. 
. * ---- report means + one-sided p (kit convention) across scrambles ----
. foreach v in benefits_noctrl benefits_iv did_stateu_iv {
  2.         qui sum `v'
  3.         scalar m_`v'   = r(mean)
  4.         qui count if `v'>0 & !missing(`v')
  5.         scalar fgt0 = r(N)
  6.         qui count if !missing(`v')
  7.         scalar ntot = r(N)
  8.         scalar p_`v' = min(fgt0/ntot, 1-fgt0/ntot)
  9.         di as txt "`v': mean=" as res %8.4f m_`v' as txt "  frac>0=" as re
> s %5.3f (fgt0/ntot) as txt "  one-sided p=" as res %5.3f p_`v'
 10. }
benefits_noctrl: mean=  0.1061  frac>0=1.000  one-sided p=0.000
benefits_iv: mean= -0.0255  frac>0=0.490  one-sided p=0.490
did_stateu_iv: mean= -1.8710  frac>0=0.005  one-sided p=0.005

. di as txt "(targets: benefits_noctrl ~0.107 p0 ; benefits_iv -0.069 p0.31 ; d
> id_stateu -2.234 p0)"
(targets: benefits_noctrl ~0.107 p0 ; benefits_iv -0.069 p0.31 ; did_stateu -2.
> 234 p0)

. 
