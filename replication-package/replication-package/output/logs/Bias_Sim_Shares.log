. count if emp_share<0.15
  1,108

. scalar n_small = r(N)

. qui sum emp_share if emp_share<0.15

. scalar avg_small = r(mean)

. 
. count if emp_share>=0.15
  64

. scalar n_large = r(N)

. qui sum emp_share if emp_share>=0.15

. scalar avg_large = r(mean)

