. foreach s in total private {
  2.     if "`s'"=="private" local own = 5
  3.     else                local own = 0
  4. 
.     forvalues yr=1975/1989 {
  5.         disp as text "QCEW historical `s' year=" as result `yr'
  6.         clear
  7.         insheet using "`RAW'/`yr'.q1-q4 10 Total, all industries.csv", com
> ma
  8. 
.         keep if agglvl_code == 70 | agglvl_code==71      // county
  9.         keep if size_code==0
 10.         keep if own_code==`own'                          // 0 total / 5 pr
> ivate
 11. 
.         destring area_fips, replace
 12.         gen fipsnumeric=area_fips
 13.         drop if fipsnumeric > 56000
 14. 
.         forvalues x=1/3 {
 15.             gen emp`x'=month`x'_emplvl
 16.         }
 17.         rename qtr quarter
 18.         keep fipsnumeric year quarter emp* total_qtrly_wages avg_wkly_wage
 19.         reshape long emp, i(fipsnumeric quarter) j(month)
 20.         replace month=(quarter-1)*3+month
 21. 
