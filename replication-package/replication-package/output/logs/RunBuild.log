. do RunBuild.do 

. *****************************************************************************
> *****************
. * RunBuild.do  --  one-command orchestrator for the entire data build.
. *
. * Run from the code/ directory:
. *     do "RunBuild.do"                 (interactive)
. *     stata-mp -b do RunBuild.do       (batch)
. *
. * config.do is sourced ONCE here. Its globals (${rawdata} ${code} ${processed
> } ${vacfile} ...)
. * survive the `clear all' at the top of each child script, so no child needs 
> to re-set paths.
. * `cd "${code}"' is reissued before each child because several producers cd i
> nto working dirs.
. *
. * ---------------------------------------------------------------------------
> ------------------
. * STAGE 1 (default ON) -- build every from-raw input in data/raw/ from primar
> y sources, via the
. *   producers in build/RawDataScripts/.  The archive ships NO pre-built inter
> mediates, so this
. *   stage runs by default (`rebuild_from_raw' = 1).  Each source's raw inputs
>  and build steps are
. *   documented in build/RawDataScripts/<source>/SOURCE_NOTES.md.
. *
. *   NOT built by Stage 1 (shipped as PROVIDED inputs -- no in-kit producer):
. *     benefit weeks       benefit_weeks (the ONE consolidated weeks input the
>  build
. *                         merges), plus Fullbenefits_MeanWks_Update (consumed
>  only by
. *                         the LAUS Stage-1 chain, step 2)
. *     external downloads  LatLongData, cbsacode_xwalk
. *     archived/published  population_age (Census county pop, pre-rebase vinta
> ge),
. *                         cpssep (Shimer 2012 separation series)
. *
. *   One Stage-1 step is MATLAB, which Stata cannot call: JobFinding/step1_bac
> koutf_fp.m. Run it in
. *   MATLAB first (do_replication.sh does this); it writes jobfindingfp_v12.tx
> t that steps 2-3 consume.
. *
. * STAGE 2 (always) -- build the three master datasets in data/processed/ via 
> UIMacro_BuildData.do:
. *   UIMacro_RevisionData, UIMacro_DataControls, ProcessedWages.
. *
. * HWOL county/state vacancies are proprietary; the kit ships a synthetic stan
> d-in and the build
. * reads it through ${vacfile}/${statefile} (config), so only public/synthetic
>  data is used. The
. * Data Editor swaps in licensed HWOL via those switches to reproduce publishe
> d vacancy numbers.
. *****************************************************************************
> *****************
. 
. clear all

. do "config.do"

. * ===========================================================================
. * config.do  --  single path configuration for the replication archive.
. *
. * HOW TO RUN: from a Stata session whose working directory is `code/`, first
. *     do "config.do"
. * then run any pipeline script (also from `code/`), e.g. `do build/UIMacro_Bu
> ildData.do`.
. * Each pipeline script re-runs this file itself, so you can also run them dir
> ectly
. * from `code/`. EDIT THE ONE LINE below to this archive's location on your ma
> chine.
. * ===========================================================================
. 
. global root "/Users/mac/JPE-replications/JPE-Mitman-2016256/replication-packa
> ge/replication-package"          //  <-- EDIT: path to this archive

. 
. * --- derived locations (do not edit) ---
. global code          "${root}/code"

. global rawdata       "${root}/data/raw"

. global processed     "${root}/data/processed"

. global output        "${root}/output"

. global tables        "${output}/tables"

. global figures       "${output}/figures"

. global factor_csv    "${output}/factor_results"      // analysis/Matlab resul
> t CSVs (make_tables reads)

. global factor_inputs "${output}/factor_inputs"       // per-pair QBLS handoff
>  (regenerated by exporters)

. global synthetic     "${root}/synthetic-data"

. 
. * --- analysis convenience: cd "${maindirectory}"; use "${CurrentData}" / "${
> DataControls}.dta" ---
. global maindirectory "${processed}/"

. global CurrentData   "UIMacro_RevisionData.dta"

. global DataControls  "UIMacro_DataControls"

. global Wages         "ProcessedWages.dta"

