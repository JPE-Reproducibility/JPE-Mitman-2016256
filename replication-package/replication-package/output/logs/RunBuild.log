> wi_{ST}.csv":
. *       for z in *Priv.zip; do st=${z%Priv.zip}; mkdir -p ${st}Priv; \
. *         unzip -o $z -d ${st}Priv >/dev/null; \
. *         mv ${st}Priv/qwi_*.csv ${st}Priv/qwi_${st}.csv; done
. * ---------------------------------------------------------------------------
