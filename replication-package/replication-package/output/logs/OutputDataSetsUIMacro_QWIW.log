. do exporters/OutputDataSetsUIMacro_QWIW.do 

. * ---------------------------------------------------------------------------
. * OutputDataSetsUIMacro_QWIW.do
. *
. * Wage exporter for paper tab:Benefits_on_Wages (§5.2, main text) and
. * tab:app_Benefits_on_Wages (wages appendix). Counterpart Matlab front-end:
. * code/matlab/Factor_FrontEnd_QWIW.m.
. *
. * Unlike the unemployment exporters (which read the pre-differenced
. * DataControls), the wage double-differences live in ProcessedWages, built by
. * code/build/MakeWageData.do. We load that vintage here and outsheet one
. * balanced QBLS per pair. RunFactorModel masks the per-LHS missingness, so th
> e
. * three wage measures (stayers / new hires / all workers) each recover their
. * own observation count from a single exported panel.
. *
. * QBLS column contract (var_ind in the front-end picks the LHS column):
. *   col 1  fipsnumeric
. *   col 2  year
. *   col 3  quarter
. *   col 4  ben_1                       (double-differenced benefit weeks; RHS
> )
. *   col 5  did_logqwi_wage2f_0         Job Stayers, raw          (app Cols 1)
. *   col 6  did_logqwi_wage2f_t_0       Job Stayers, with tax     (app Cols 2)
. *   col 7  kqwinew                     New Hires, raw            (app Cols 3)
. *   col 8  kqwinew_t                   New Hires, with tax       (app Cols 4)
. *   col 9  kqwitot                     All Workers, raw          (main Col 1)
. *   col 10 kqwitot_t                   All Workers, with tax     (main Col 2)
. *
. * The "stayers" LHS is the QWI full-quarter stable-earnings double difference
. * (wage2f = qwiw3f/qwiw4f), labelled 'stayers0' in the original front-end.
. * The "new hires" and "all workers" LHS are the smoothed-level (kmean_*_1)
. * two-period quasi-differences of QWI new-hire (wnhf) and total (wtot) wages,
. * matching the original exporter. The _t suffix adds the UI
. * payroll-tax adjustment (diff_logui_tax_rate baked into MakeWageData).
. * ---------------------------------------------------------------------------
. 
. do "config.do"

. * ===========================================================================
. * config.do  --  single path configuration for the replication archive.
. *
. * HOW TO RUN: from a Stata session whose working directory is `code/`, first
. *     do "config.do"
. * then run any pipeline script (also from `code/`), e.g. `do build/UIMacro_Bu
> ildData.do`.
. * Each pipeline script re-runs this file itself, so you can also run them dir
> ectly
. * from `code/`. EDIT THE ONE LINE below to this archive's location on your ma
> chine.
. * ===========================================================================
. 
. global root "/Users/mac/JPE-replications/JPE-Mitman-2016256/replication-packa
> ge/replication-package"          //  <-- EDIT: path to this archive

. 
. * --- derived locations (do not edit) ---
. global code          "${root}/code"

. global rawdata       "${root}/data/raw"

. global processed     "${root}/data/processed"

. global output        "${root}/output"

. global tables        "${output}/tables"

. global figures       "${output}/figures"

. global factor_csv    "${output}/factor_results"      // analysis/Matlab resul
> t CSVs (make_tables reads)

. global factor_inputs "${output}/factor_inputs"       // per-pair QBLS handoff
>  (regenerated by exporters)

. global synthetic     "${root}/synthetic-data"

. 
. * --- analysis convenience: cd "${maindirectory}"; use "${CurrentData}" / "${
> DataControls}.dta" ---
. global maindirectory "${processed}/"

. global CurrentData   "UIMacro_RevisionData.dta"

. global DataControls  "UIMacro_DataControls"

. global Wages         "ProcessedWages.dta"

. global outdirectory  "${factor_inputs}/"             // exporters write QBLS 
> here

. global latexdir      "${factor_csv}/"                // analysis/Matlab resul
> t CSVs (make_tables reads)

. 
. * --- vacancy data switch ---------------------------------------------------
. * vacfile/statefile are the two PROVIDED synthetic stand-ins for the propriet
> ary HWOL
. * inputs (synthetic-data/; the confidential HWOL data are NOT in this archive
> ). To reproduce the PUBLISHED (HWOL)
. * vacancy numbers, the Data Editor replaces these two files with the licensed
>  Conference
. * Board HWOL data and re-runs. See code/build/SYNTHETIC_VACANCY_PATH.md.
. global vacfile      "${synthetic}/new_vac_synthetic.dta"

. global statefile    "${synthetic}/StateMonthlyBorderData_synthetic.dta"

. * ImputedDataBorder is a BUILT intermediate, NOT shipped: the replicator gene
> rates it by
. * running the imputation (analysis/Impute_Input.do -> matlab/Run_Impute_Borde
> r.m ->
. * analysis/Impute_to_Stata.do) on ${vacfile}; it lands in data/processed/ (sy
> nthetic by
. * default, the real version if the Data Editor swaps in HWOL).
. global ImputedFile  "${processed}/ImputedDataBorder.dta"

. 
. * --- figure styling: the published figures were drawn under the classic
. * s2color scheme; Stata 18+ defaults to stcolor, which changes gridlines,
. * markers, and legend styling. Pin the scheme so regenerated figures match.
. cap set scheme s2color

. 
. * ensure the built-output folders exist (the archive ships them empty / absen
> t)
. cap mkdir "${processed}"

. cap mkdir "${output}"

. cap mkdir "${tables}"

. cap mkdir "${figures}"

. cap mkdir "${factor_csv}"

. cap mkdir "${factor_inputs}"

