. // Loop over 8 distance configurations (20/30/40/50 miles, < and >).
. // Each writes its own output/factor_inputs/Dist{cut}{Lt|Gt}/ subdirectory of
. // QBLS files. The 8-column outsheet contract matches Bench (so a future
. // Beg variant of this table is a one-line var_ind change in Matlab):
. //   col 1 fipsnumeric, col 2 year, col 3 quarter,
. //   col 4 diff_logmeanwks, col 5 qdk1_logunemp_rate_laus,
. //   col 6 diff_logprod_priv, col 7 diff_logprod_all,
. //   col 8 diff_logmeanwks_pf, col 9 qdsbk1_logunemp_rate_laus.
. preserve

. foreach cut in 20 30 40 50 {
  2. foreach dir in Lt Gt {
  3. 
.         restore, preserve
  4. 
.         sort pair_id_numeric county_index
  5.         keep if county_index==1
  6. 
.         // dist is a pair-level variable; strict inequalities exhaust the sam
> ple
.         // (no pairs have dist exactly equal to a cut value).
.         if "`dir'"=="Lt" {
  7.                 keep if dist < `cut'
  8.         }
  9.         else {
 10.                 keep if dist > `cut'
 11.         }
 12. 
.         foreach var of varlist                                               
>                                                                              
>               ///
>                                                                              
>                                                                              
>                                                                       ///
>                 qdk1_logunemp_rate_laus diff_logprod_priv diff_logprod_all   
>                                                                              
>               ///                                                            
>                                                                              
>             ///
>                                                                              
>                                                                              
>                                                       ///
>                 diff_logmeanwks { ///
> 
 13.                 qui bys pair_id_numeric fipsnumeric: egen nmissing=count(`
> var')
 14.                 by pair_id_numeric: egen nmissing2=min(nmissing)
 15.                 qui tab nmissing
 16.                 drop if nmissing2==0
 17.                 qui drop nmissing nmissing2
 18. 
.         }
 19. 
.         qui sort pair_id_numeric fipsnumeric year quarter
 20.         qui by pair_id_numeric: gen temp=_n==1
 21.         qui gen temp2=sum(temp)
 22.         tab temp2
 23.         qui drop pair_id_numeric
 24.         qui ren temp2 pair_id_numeric
 25.         qui drop temp
 26.         qui sum pair_id_numeric
 27.         local maxid=r(max)
 28.         qui sum time
 29.         local mint=r(min)
 30.         replace time=time-`mint'+1
 31. 
.         sort pair_id_numeric quarter_index
 32. 
.         cd "$outdirectory"
 33.         capture mkdir "Dist`cut'`dir'"
 34.         cd "Dist`cut'`dir'"
 35.         file open myfile using "N.txt", write replace
 36.         file write myfile "`maxid'"
 37.         file close myfile
 38.         forvalues i=1/`maxid'{
 39.                 qui outsheet fipsnumeric year quarter diff_logmeanwks qdk1
> _logunemp_rate_laus diff_logprod_priv diff_logprod_all diff_logmeanwks_pf qds
> bk1_logunemp_rate_laus ///
>                         if pair_id_numeric==`i' using QBLS`i'.txt, replace no
> names
 40.         }
 41. 
.         capture drop st_min
 42.         capture drop st_max
 43.         capture drop bordersegment
 44. 
.         bys pair_id_numeric: egen st_min=min(fipsstate)
 45.         by  pair_id_numeric: egen st_max=max(fipsstate)
 46.         egen bordersegment=group(st_min st_max)
 47. 
.         bys bordersegment pair_id_numeric: gen temp=_n==1
 48.         sort bordersegment pair_id_numeric fipsnumeric time
 49.         qui outsheet bordersegment pair_id_numeric using bordersegment_clu
> ster.txt if temp==1, nonames replace
 50.         drop temp
 51. 
.         cd "${maindirectory}"
 52.         display "Distance Dist`cut'`dir' done (`maxid' pairs)"
 53. }
 54. }
