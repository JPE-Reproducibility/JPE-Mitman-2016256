. scalar ml_coef = _b[diff_logmeanwks]

. scalar ml_n    = e(N)

. scalar ml_r2   = e(r2)

. 
. gen predvar = qdk1_logadju_c-ehat
(3,780 missing values generated)

. matrix observe=_b[diff_logmeanwks]

. sort pair_id_numeric quarter_index

. gen unique_id=_n

. keep bordersegment qdk1_logadju_c diff_logmeanwks id pair_id_numeric quarter_
> index unique_id ehat predvar fq1 fq2

. 
. * --- Residual cluster bootstrap over border segments (200 reps) ---
. capture program drop myboot

. program define myboot, rclass
  1. preserve
  2. tempfile OrigSamp
  3. save "`OrigSamp'"
  4. bsample, cluster(bordersegment) id(newborder)
  5. gen newid = newborder*10000+pair_id_numeric
  6. sort newborder pair_id_numeric quarter_index
  7. replace unique_id=_n
  8. keep unique_id ehat newid
  9. rename ehat ehatresamp
 10. merge 1:1 unique_id using "`OrigSamp'"
 11. keep if _merge==3
 12. gen LHSvar = predvar+ehatresamp
 13. xtset newid quarter_index
 14. reghdfe LHSvar diff_logmeanwks, abs(i.newid#c.fq1 i.newid#c.fq2)
 15. return scalar wkscoef=_b[diff_logmeanwks]
 16. restore
 17. end

. 
. simulate wkscoef=r(wkscoef), reps(200) seed(12345): myboot

      Command: myboot
      wkscoef: r(wkscoef)

