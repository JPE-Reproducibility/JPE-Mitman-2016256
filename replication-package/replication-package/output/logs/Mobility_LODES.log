. * Write the single-coefficient result: [coef, bootstrap SE, N.factors, R2, No
> bs].
. clear

. quietly set obs 1

. gen coef    = ml_coef

. gen bse     = ml_bse

. gen factors = 2

. gen r2      = ml_r2

. gen nobs    = ml_n

. outsheet coef bse factors r2 nobs using "${latexdir}Mobility_LODES.csv", comm
> a nonames replace
