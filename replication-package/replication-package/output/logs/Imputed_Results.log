. * ===================== residual cluster bootstrap =====================
. capture program drop myboot

. program define myboot, rclass
  1. preserve
  2. tempfile OrigSamp
  3. save "`OrigSamp'"
  4. bsample, cluster(bordersegment) id(newborder)
  5. gen newid = newborder*10000+pair_id_numeric
  6. sort newborder pair_id_numeric quarter_index
  7. replace unique_id=_n
  8. keep unique_id ehat newid
  9. rename ehat ehatresamp
 10. merge 1:1 unique_id using "`OrigSamp'"
 11. keep if _merge==3
 12. gen LHSvar = predvar+ehatresamp
 13. xtset newid quarter_index
 14. regife LHSvar diff_logmeanwks, noconst f(pair_id_numeric quarter_index,2)
 15. return scalar wkscoef=_b[diff_logmeanwks]
 16. restore
 17. end

. 
. matrix IMP = J(3,5,.)   // rows = cols 1-3; [coef, se, N, R2, n_factors]

. 
. * col_lhs holds the LHS variable for each column.
. local lhs1 did_logx

. local lhs2 jolts_udiff_logthet_corr

. local lhs3 jolts_udiff_logf

. 
. forvalues i=1/3{
  2.         use "`prepped'", clear
  3.         * Drop rows where this column's LHS (or the benefit RHS) is missin
> g, so the
.         * IFE factor structure sees no all-empty quarter levels. CurrentData 
> runs to
.         * 2014 but the imputation only covers 2005-2011, so the trailing quar
> ters are
.         * empty for the imputed LHS and would otherwise trip regife ("more le
> vels of FE
.         * than observations"). (County_Data_contig did not span those years.)
.         keep if !missing(`lhs`i'', diff_logmeanwks)
  4.         xtset pair_id_numeric quarter_index
  5. 
.         regife `lhs`i'' diff_logmeanwks, f(pair_id_numeric quarter_index, 2) 
> noconst
  6.         scalar coef`i' = _b[diff_logmeanwks]
  7.         scalar nobs`i' = e(N)
  8.         scalar rsq`i'  = e(r2)
  9. 
.         predict predvar
 10.         gen ehat = `lhs`i'' - predvar
 11.         sort pair_id_numeric quarter_index
 12.         gen unique_id=_n
 13.         keep bordersegment `lhs`i'' diff_logmeanwks pair_id_numeric quarte
> r_index unique_id ehat predvar
 14. 
.         simulate wkscoef=r(wkscoef), reps(200) seed(20180802): myboot
 15.         qui summarize wkscoef
 16.         scalar bse`i' = r(sd)
 17. 
.         matrix IMP[`i',1]=coef`i'
 18.         matrix IMP[`i',2]=bse`i'
 19.         matrix IMP[`i',3]=nobs`i'
 20.         matrix IMP[`i',4]=rsq`i'
 21.         matrix IMP[`i',5]=2
 22. }
