. // Loop: for each scramble x, replace the pair/county identifiers with the
. // scrambled ones, recompute pair-differences and quasi-differences, and writ
> e
. // QBLS files for the Matlab factor model into output/factor_inputs/Scramble`
> x'/.
. // Inside the same loop, also run the OLS specification used by the additive-
. // effects appendix table (tab:Benefits_on_unemp_OLS) Cols 3-4 -- baseline an
> d
. // + State GDP per Worker control (diff_logprod_all). Per-scramble OLS coefs
. // and clustered SEs collected into matrices and written out after the loop.
. matrix scramble_ols_base = J(200, 4, .)

. matrix scramble_ols_prod = J(200, 6, .)

. preserve

. forvalues x=1/200{
  2. 
.         replace pair_id_numeric = new_pair_id`x'
  3.         replace county_index = new_county_index`x'
  4. 
.         capture drop time
  5.         gen time = quarter_index
  6. 
.         // Pair-differences (across counties within a scrambled pair)
.         sort pair_id_numeric time county_index
  7.         capture drop diff_logmeanwks
  8.         capture drop diff_logunemp_rate_laus
  9.         capture drop diff_logprod_priv
 10.         capture drop diff_logprod_all
 11.         foreach var of varlist logmeanwks logunemp_rate_laus logprod_priv 
> logprod_all {
 12.                 qui by pair_id_numeric time: gen diff_`var' = `var'[1] - `
> var'[2]
 13.         }
 14. 
.         // Forward (lead) and 1-period quasi-differences of unemployment.
.         // qdk1 uses the JOLTS-style seprate; qdsbk1 uses the QWI beginning-o
> f-quarter
.         // pair separation rate, normalised by 1.353 so its mean matches JOLT
> S (the
.         // scaling factor follows the build script and the paper appendix).
.         sort pair_id_numeric county_index time
 15.         capture drop f1_logunemp_rate_laus
 16.         capture drop qdk1_logunemp_rate_laus
 17.         capture drop qdsbk1_logunemp_rate_laus
 18.         qui by pair_id_numeric county_index: gen f1_logunemp_rate_laus = d
> iff_logunemp_rate_laus[_n+1]
 19.         qui by pair_id_numeric county_index: gen qdk1_logunemp_rate_laus =
>  diff_logunemp_rate_laus - ((0.99*(1-seprate))^1)*f1_logunemp_rate_laus
 20.         qui by pair_id_numeric county_index: gen qdsbk1_logunemp_rate_laus
>  = diff_logunemp_rate_laus - ((0.99*(1-pair_sepr_beg/1.353))^1)*f1_logunemp_r
> ate_laus
 21. 
.         keep if county_index==1
 22.         qui duplicates drop pair_id_numeric quarter_index, force
 23. 
.         foreach var of varlist                                               
>                                                                              
>               ///
>                                                                              
>                                                                              
>                                                                       ///
>                 qdk1_logunemp_rate_laus diff_logprod_priv diff_logprod_all   
>                                                                              
>               ///                                                            
>                                                                              
>             ///
>                                                                              
>                                                                              
>                                                       ///
>                 diff_logmeanwks { ///
> 
 24.                 qui bys pair_id_numeric fipsnumeric: egen nmissing=count(`
> var')
 25.                 qui by pair_id_numeric: egen nmissing2=min(nmissing)
 26.                 qui drop if nmissing2==0
 27.                 qui drop nmissing nmissing2
 28. 
.         }
 29. 
.         qui sort pair_id_numeric fipsnumeric year quarter
 30.         qui by pair_id_numeric: gen temp=_n==1
 31.         qui gen temp2=sum(temp)
 32.         qui drop pair_id_numeric
 33.         qui ren temp2 pair_id_numeric
 34.         qui drop temp
 35.         qui sum pair_id_numeric
 36.         local maxid=r(max)
 37.         qui sum time
 38.         local mint=r(min)
 39.         qui replace time=time-`mint'+1
 40. 
.         sort pair_id_numeric quarter_index
 41. 
.         cd "$outdirectory"
