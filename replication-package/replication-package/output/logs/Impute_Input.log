                                    b_l   ->   b_lA b_lB
                                    b_p   ->   b_pA b_pB
                                  b_vac   ->   b_vacA b_vacB
                                    phi   ->   phiA phiB
                                      q   ->   qA qB
-----------------------------------------------------------------------------

. 
. gen qratio = qA / qB

. 
. * Keep periods where the core inputs are present for both sides.
. keep if !missing(phiA, phiB, b_vacA, b_vacB, b_uA, b_uB, b_lA, b_lB, b_pA, b_
> pB, qratio)
(0 observations deleted)

. 
